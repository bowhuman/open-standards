{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codeberg.org/bowhuman/open-standards/raw/branch/main/schemas/equipment-set-v1.schema.json",
  "title": "BHS-005 Equipment Set v1",
  "description": "Bowhuman Standard BHS-005: ein benanntes Bogen+Pfeil-Set (equipment_sets), mit eingebetteten Bogen-/Pfeil-Snapshots",
  "type": "object",
  "required": ["__type", "__version", "id", "label", "is_active", "created_at"],
  "additionalProperties": true,
  "properties": {
    "__type":    { "type": "string", "const": "bhs-equipment-set" },
    "__version": { "type": "integer", "const": 1 },
    "id":        { "type": "string", "format": "uuid" },
    "label":     { "type": "string", "minLength": 1 },
    "bow":   { "oneOf": [{ "$ref": "#/definitions/BowSnapshot" }, { "type": "null" }] },
    "arrow": { "oneOf": [{ "$ref": "#/definitions/ArrowSnapshot" }, { "type": "null" }] },
    "is_active":  { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "definitions": {
    "BowSnapshot": {
      "type": "object",
      "description": "Strukturell identisch mit bow-v1.schema.json, aber ohne __type/__version — eingebettete Kopie zum Exportzeitpunkt (BHS-005 §4.1)",
      "required": ["id", "label", "bow_type", "equipment_class", "created_at"],
      "additionalProperties": true,
      "properties": {
        "id":    { "type": "string", "format": "uuid" },
        "label": { "type": "string", "minLength": 1 },
        "bow_type": {
          "type": "string",
          "enum": ["Recurve", "Compound", "Blankbogen", "Langbogen", "Instinktiv", "Primitivbogen", "Armbrust"]
        },
        "equipment_class": {
          "type": "string",
          "description": "Kanonisches, abgeleitetes Cross-Standard-Vokabular (BHS-003, EquipmentClass). Siehe bow-v1.schema.json.",
          "enum": ["recurve", "compound", "barebow", "longbow", "traditional", "crossbow"]
        },
        "brand": { "type": ["string", "null"] },
        "draw_weight_lbs": { "type": ["number", "null"], "minimum": 0 },
        "draw_length_in":  { "type": ["number", "null"], "minimum": 0 },
        "bow_length_in":   { "type": ["number", "null"], "minimum": 0 },
        "brace_height_in": { "type": ["number", "null"], "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "ArrowSnapshot": {
      "type": "object",
      "description": "Strukturell identisch mit arrow-v1.schema.json, aber ohne __type/__version — eingebettete Kopie zum Exportzeitpunkt (BHS-005 §4.1)",
      "required": ["id", "label", "created_at"],
      "additionalProperties": true,
      "properties": {
        "id":    { "type": "string", "format": "uuid" },
        "label": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "material": {
          "type": ["string", "null"],
          "enum": ["Carbon", "Aluminium", "Carbon-Alu", "Holz", null]
        },
        "spine":           { "type": ["number", "null"] },
        "length_in":       { "type": ["number", "null"], "minimum": 0 },
        "point_weight_gr": { "type": ["number", "null"], "minimum": 0 },
        "total_weight_gr": { "type": ["number", "null"], "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

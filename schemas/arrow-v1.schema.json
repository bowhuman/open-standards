{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codeberg.org/bowhuman/open-standards/raw/branch/main/schemas/arrow-v1.schema.json",
  "title": "BHS-005 Arrow v1",
  "description": "Bowhuman Standard BHS-005: ein Pfeilmodell (equipment_arrows)",
  "type": "object",
  "required": ["__type", "__version", "id", "label", "created_at"],
  "additionalProperties": true,
  "properties": {
    "__type":    { "type": "string", "const": "bhs-arrow" },
    "__version": { "type": "integer", "const": 1 },
    "id":        { "type": "string", "format": "uuid" },
    "label":     { "type": "string", "minLength": 1 },
    "model":     { "type": ["string", "null"] },
    "material": {
      "type": ["string", "null"],
      "enum": ["Carbon", "Aluminium", "Carbon-Alu", "Holz", null]
    },
    "spine":           { "type": ["number", "null"] },
    "length_in":       { "type": ["number", "null"], "minimum": 0 },
    "point_weight_gr": { "type": ["number", "null"], "minimum": 0 },
    "total_weight_gr": { "type": ["number", "null"], "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}

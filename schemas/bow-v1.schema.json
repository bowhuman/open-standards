{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codeberg.org/bowhuman/open-standards/raw/branch/main/schemas/bow-v1.schema.json",
  "title": "BHS-005 Bow v1",
  "description": "Bowhuman Standard BHS-005: ein einzelner Bogen (equipment_bows)",
  "type": "object",
  "required": ["__type", "__version", "id", "label", "bow_type", "equipment_class", "created_at"],
  "additionalProperties": true,
  "properties": {
    "__type":    { "type": "string", "const": "bhs-bow" },
    "__version": { "type": "integer", "const": 1 },
    "id":        { "type": "string", "format": "uuid" },
    "label":     { "type": "string", "minLength": 1 },
    "bow_type": {
      "type": "string",
      "enum": ["Recurve", "Compound", "Blankbogen", "Langbogen", "Instinktiv", "Primitivbogen", "Armbrust"]
    },
    "equipment_class": {
      "type": "string",
      "description": "Kanonisches, abgeleitetes Cross-Standard-Vokabular (BHS-003, EquipmentClass). Verlustbehaftet gegenueber bow_type: Instinktiv und Primitivbogen werden beide zu traditional (BHS-005 Abschnitt 2.3).",
      "enum": ["recurve", "compound", "barebow", "longbow", "traditional", "crossbow"]
    },
    "brand": { "type": ["string", "null"] },
    "draw_weight_lbs": { "type": ["number", "null"], "minimum": 0 },
    "draw_length_in":  { "type": ["number", "null"], "minimum": 0 },
    "bow_length_in":   { "type": ["number", "null"], "minimum": 0 },
    "brace_height_in": { "type": ["number", "null"], "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
